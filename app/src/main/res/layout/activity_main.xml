<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/fondo_crema"
    android:padding="24dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Módulos del Sistema"
        android:textColor="@color/texto_oscuro"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnIrProveedores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Gestión de Proveedores"
        android:textColor="@color/white"
        android:backgroundTint="@color/azul_principal"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnIrAlmacen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Gestión de Almacenes"
        android:textColor="@color/white"
        android:backgroundTint="@color/naranja_acento" />

</LinearLayout>